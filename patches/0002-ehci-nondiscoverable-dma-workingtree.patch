diff --git a/MdeModulePkg/Bus/Pci/EhciDxe/EhciSched.c b/MdeModulePkg/Bus/Pci/EhciDxe/EhciSched.c
index 59bbe9f..c22667c 100644
--- a/MdeModulePkg/Bus/Pci/EhciDxe/EhciSched.c
+++ b/MdeModulePkg/Bus/Pci/EhciDxe/EhciSched.c
@@ -155,6 +155,9 @@ EhcInitSched (
   Ehc->PeriodFrame    = Buf;
   Ehc->PeriodFrameMap = Map;
 
+  DEBUG ((DEBUG_ERROR, "EhcInitSched: PeriodFrame Buf=0x%lx PhyAddr=0x%lx Bytes=0x%lx\n",
+    (UINT64)(UINTN)Buf, (UINT64)PhyAddr, (UINT64)Bytes));
+
   //
   // Program the FRAMELISTBASE register with the low 32 bit addr
   //
@@ -214,6 +217,7 @@ EhcInitSched (
   // the reclamation header
   //
   PciAddr = UsbHcGetPciAddressForHostMem (Ehc->MemPool, Ehc->ReclaimHead, sizeof (EHC_QH));
+  DEBUG ((DEBUG_ERROR, "EhcInitSched: ReclaimHead PciAddr=0x%lx\n", (UINT64)PciAddr));
   EhcWriteOpReg (Ehc, EHC_ASYNC_HEAD_OFFSET, EHC_LOW_32BIT (PciAddr));
   return EFI_SUCCESS;
 
